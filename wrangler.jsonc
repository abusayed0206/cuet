{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cuet",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "CUET_students",
			"database_id": "f4b7db3e-ee71-4af0-8914-1a541f6c87a3"
		}
	],
	// Per-IP limit for /api/* (cached responses are served before this check).
	"ratelimits": [
		{
			"name": "API_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 60, "period": 60 }
		}
	],
	"observability": {
		"enabled": true
	}
}
