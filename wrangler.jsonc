{
	"name": "cuet",
	"compatibility_date": "2025-11-09",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Astro App Configuration
	"main": "dist/_worker.js/index.js",
	"assets": {
		"directory": "dist",
		"binding": "ASSETS"
	},
	// D1 Database Binding
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "CUET_students",
			"database_id": "f4b7db3e-ee71-4af0-8914-1a541f6c87a3"
		}
	],
	// Enable observability
	"observability": {
		"enabled": true
	}
}