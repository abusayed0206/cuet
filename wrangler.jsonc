{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cuet",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "CUET_students",
			"database_id": "f4b7db3e-ee71-4af0-8914-1a541f6c87a3"
		}
	],
	"observability": {
		"enabled": true
	}
}
