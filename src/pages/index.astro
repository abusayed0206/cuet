---
import Layout from '../layouts/Layout.astro';
import HomeClient from '../components/HomeClient';
---

<Layout title="CUET Students Directory | Find Peers and Alumni">
  <div class="flex-1 flex flex-col items-center justify-center px-4 sm:px-6 lg:px-8 py-12">
    <div class="w-full max-w-4xl mx-auto flex flex-col items-center">
      
      {/* Hero Section */}
      <div class="text-center mb-10">
        <div class="inline-flex mb-4">
          <img
            src="/CUET_Vector_ogo.svg"
            alt="CUET Logo"
            class="w-16 h-16 sm:w-20 sm:h-20 opacity-90"
            loading="eager"
          />
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-3 text-slate-800 tracking-tight">
          CUET Students Directory
        </h1>
        <p class="text-base sm:text-lg text-slate-500 max-w-xl mx-auto">
          Search the official unofficial database to find peers and alumni.
        </p>
      </div>

      {/* Search Card - React Component */}
      <HomeClient client:load />

      {/* Quick Actions Grid - Highlighted */}
      <div class="w-full max-w-3xl">
        <p class="text-sm font-medium text-slate-400 uppercase tracking-wide text-center mb-6">Or explore directories</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          
          <a href="/batch" class="group bg-blue-50/50 hover:bg-blue-50 border border-blue-100 rounded-2xl p-5 transition-all duration-200 flex items-center gap-4">
            <div class="w-12 h-12 bg-white rounded-full shadow-sm border border-blue-100 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
              <svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z" /></svg>
            </div>
            <div>
              <h3 class="font-semibold text-slate-800 text-lg mb-0.5">Browse by Batch</h3>
              <p class="text-slate-500 text-sm">Filter students by their admission year and department.</p>
            </div>
          </a>

          <a href="/search" class="group bg-indigo-50/50 hover:bg-indigo-50 border border-indigo-100 rounded-2xl p-5 transition-all duration-200 flex items-center gap-4">
            <div class="w-12 h-12 bg-white rounded-full shadow-sm border border-indigo-100 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
              <svg class="w-6 h-6 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
            </div>
            <div>
              <h3 class="font-semibold text-slate-800 text-lg mb-0.5">Search by Name</h3>
              <p class="text-slate-500 text-sm">Look up any student by typing their full or partial name.</p>
            </div>
          </a>

        </div>

        {/* Smaller secondary links */}
        <div class="flex items-center justify-center gap-6 mt-10">
          <a href="/privacy" class="text-sm text-slate-500 hover:text-slate-800 transition-colors">
            Privacy Policy
          </a>
          <a href="/terms" class="text-sm text-slate-500 hover:text-slate-800 transition-colors">
            Terms of Service
          </a>
        </div>
      </div>
    </div>
  </div>

  {/* Footer */}
  <footer class="mt-auto py-6 text-center">
    <p class="text-slate-500 text-sm">
      Designed & Developed by{" "}
      <a 
        href="https://sayed.page/" 
        target="_blank" 
        rel="noopener noreferrer"
        class="font-medium text-slate-700 hover:text-blue-600 transition-colors"
      >
        Sayed
      </a>
      <span class="mx-2 text-slate-300">•</span>
      ID: 1901049
    </p>
  </footer>
</Layout>
