---
import Layout from '../layouts/Layout.astro';
import StudentDetails from '../components/StudentDetails';
import { getStudentById } from '../utils/d1';

const { studentId } = Astro.params;

const validateStudentId = (id: string) => {
  const regex = /^[0-9]{7}$/;
  if (!regex.test(id)) return false;
  const batchYear = parseInt(id.slice(0, 2), 10);
  const departmentCode = parseInt(id.slice(2, 4), 10);
  const classRoll = parseInt(id.slice(4, 7), 10);
  if (batchYear < 0 || batchYear > 99) return false;
  if (departmentCode < 1 || departmentCode > 12) return false;
  if (classRoll < 1 || classRoll > 200) return false;
  return true;
};

let studentData = null;
let error = '';

if (studentId) {
  if (!validateStudentId(studentId)) {
    error = 'Invalid student ID of CUET';
  } else {
    try {
      const { env } = Astro.locals.runtime;
      const student = await getStudentById(env.DB, studentId);
      
      if (!student) {
        error = 'Student not found';
      } else {
        studentData = student;
      }
    } catch (err) {
      console.error('Error fetching student:', err);
      error = 'The requested student information could not be found.';
    }
  }
} else {
  error = 'Student ID is required';
}
---

{studentData ? (
  <Layout 
    title={`${studentData.name} | ID: ${studentData.studentid}`}
    description={`${studentData.department} and ${studentData.batch} batch`}
  >
    <StudentDetails student={studentData} client:load />
  </Layout>
) : (
  <Layout title="Student Not Found | CUET Students Directory">
    <div class="flex items-center justify-center p-4 h-[calc(100vh-80px)]">
      <div class="bg-white rounded-2xl shadow-lg border border-slate-200 p-8 max-w-md w-full text-center">
        <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
          </svg>
        </div>
        <h2 class="text-xl font-semibold text-slate-800 mb-2">Student Not Found</h2>
        <p class="text-slate-600 mb-6">
          {error}
        </p>
        <a
          href="/"
          class="inline-block px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
        >
          Back to Home
        </a>
      </div>
    </div>
  </Layout>
)}
