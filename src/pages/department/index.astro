---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { getOverview } from '../../lib/db';
import { cachePage, fmt } from '../../lib/http';

cachePage(Astro);
const { departments } = await getOverview();
---

<Base title="All departments" description="Every CUET department with its batches and student counts.">
  <div class="wrap pt-8">
    <Crumbs items={[{ label: 'Departments' }]} />
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">All departments</h1>
    <p class="mt-2 text-muted">The two digits after the batch in a student ID identify the department.</p>

    <div class="mt-8 grid gap-3 md:grid-cols-2">
      {
        departments.map(({ dept, count, classes }) => {
          const years = classes.map((c) => c.batch);
          return (
            <section class="card p-4 sm:p-5">
              <a href={`/department/${dept.slug}`} class="group flex items-center gap-4">
                <span class="grid h-11 w-14 shrink-0 place-items-center rounded-[3px] bg-accent-soft font-mono text-sm font-semibold text-accent">{dept.short}</span>
                <span class="min-w-0">
                  <span class="block font-semibold group-hover:text-accent">{dept.name}</span>
                  <span class="block text-sm text-muted">
                    Code <span class="font-mono">{dept.code}</span> · {fmt(count)} students · batches {years.at(-1)}–{years[0]}
                  </span>
                </span>
              </a>
              <div class="mt-3 flex flex-wrap gap-1.5">
                {classes.map((c) => (
                  <a href={`/batch/${c.batch}/${dept.slug}`} class="chip px-2.5 py-0.5 text-xs tabular-nums">
                    {c.batch}
                  </a>
                ))}
              </div>
            </section>
          );
        })
      }
    </div>
  </div>
</Base>
