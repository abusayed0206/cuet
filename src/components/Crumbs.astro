---
interface Props {
  items: { href?: string; label: string }[];
}
const { items } = Astro.props;

// Same trail as schema.org BreadcrumbList, so search results can show it.
const trail = [{ href: '/', label: 'Home' }, ...items];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((it, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: it.label,
    item: new URL(it.href ?? Astro.url.pathname, Astro.site).href,
  })),
};
---

<nav aria-label="Breadcrumb" class="mb-4 text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-1.5">
    <li><a href="/" class="hover:text-fg">Home</a></li>
    {
      items.map((it) => (
        <li class="flex items-center gap-1.5">
          <span class="text-faint" aria-hidden="true">/</span>
          {it.href ? (
            <a href={it.href} class="hover:text-fg">
              {it.label}
            </a>
          ) : (
            <span aria-current="page" class="text-fg">
              {it.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
