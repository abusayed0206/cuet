---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import SearchBox from '../components/SearchBox.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Hide the compact search in the header (home and search pages have their own). */
  hideHeaderSearch?: boolean;
  jsonLd?: Record<string, unknown>;
}

const SITE = 'CUET Students Directory';
const {
  title,
  description = 'Search CUET students by name or ID and browse every batch and department of Chittagong University of Engineering & Technology.',
  noindex = false,
  hideHeaderSearch = false,
  jsonLd,
} = Astro.props;

const fullTitle = title ? `${title} · CUET Directory` : `${SITE} | Find Peers and Alumni`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/OG.png', Astro.site).href;
const path = Astro.url.pathname;
const nav = [
  { href: '/batch', label: 'Batches' },
  { href: '/department', label: 'Departments', short: 'Depts' },
  { href: '/search', label: 'Search' },
  { href: '/api', label: 'API' },
];
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#f5f4f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1013" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-icon-180x180.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={title ?? SITE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <header class="sticky top-0 z-30 border-b border-line bg-bg/90 backdrop-blur-md">
      <div class="wrap flex h-14 items-center gap-2 sm:gap-6">
        <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label="CUET Directory home">
          <img src="/CUET_Vector_ogo.svg" alt="" width="26" height="26" class="size-[26px]" />
          <span class="hidden leading-none sm:block">
            <span class="block text-[15px] font-semibold tracking-tight">CUET Directory</span>
            <span class="label mt-0.5 block text-[9.5px]">Students index</span>
          </span>
        </a>

        <nav class="flex items-center text-sm sm:border-l sm:border-line sm:pl-4" aria-label="Main">
          {
            nav.map((n) => (
              <a
                href={n.href}
                aria-current={isCurrent(n.href) ? 'page' : undefined}
                class="relative px-2 py-4 text-muted transition hover:text-fg aria-[current=page]:text-fg aria-[current=page]:after:absolute aria-[current=page]:after:inset-x-2 aria-[current=page]:after:-bottom-px aria-[current=page]:after:h-0.5 aria-[current=page]:after:bg-fg sm:px-3"
              >
                {n.short ? (
                  <>
                    <span class="sm:hidden">{n.short}</span>
                    <span class="hidden sm:inline">{n.label}</span>
                  </>
                ) : (
                  n.label
                )}
              </a>
            ))
          }
        </nav>

        <div class="ml-auto flex items-center gap-2">
          {!hideHeaderSearch && <SearchBox size="sm" class="hidden w-60 md:block" />}
          <button
            id="theme-toggle"
            type="button"
            class="grid size-9 place-items-center rounded-[3px] text-muted transition hover:bg-surface-2 hover:text-fg"
            aria-label="Toggle dark mode"
            title="Toggle dark mode"
          >
            <svg viewBox="0 0 24 24" class="size-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <circle cx="12" cy="12" r="8.5"></circle>
              <path d="M12 3.5v17a8.5 8.5 0 0 0 0-17Z" fill="currentColor"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-20 border-t border-line">
      <div class="wrap grid gap-8 py-10 text-sm sm:grid-cols-[2fr_1fr_1fr_1fr]">
        <div>
          <p class="font-semibold tracking-tight">CUET Students Directory</p>
          <p class="mt-2 max-w-sm text-muted">
            An independent index of Chittagong University of Engineering &amp; Technology students, compiled from public
            sources. Not an official CUET service.
          </p>
        </div>
        <div>
          <p class="label mb-3">Browse</p>
          <ul class="space-y-1.5 text-muted">
            <li><a href="/batch" class="hover:text-fg">Batches</a></li>
            <li><a href="/department" class="hover:text-fg">Departments</a></li>
            <li><a href="/search" class="hover:text-fg">Search</a></li>
          </ul>
        </div>
        <div>
          <p class="label mb-3">Developers</p>
          <ul class="space-y-1.5 text-muted">
            <li><a href="/api" class="hover:text-fg">API</a></li>
            <li><a href="https://github.com/abusayed0206/cuet" class="hover:text-fg" rel="noopener">GitHub</a></li>
            <li><a href="/sitemap.xml" class="hover:text-fg">Sitemap</a></li>
          </ul>
        </div>
        <div>
          <p class="label mb-3">About</p>
          <ul class="space-y-1.5 text-muted">
            <li><a href="/privacy" class="hover:text-fg">Privacy</a></li>
            <li><a href="/terms" class="hover:text-fg">Terms</a></li>
            <li><a href="https://sayed.dev/" class="hover:text-fg" rel="noopener">Built by Sayed</a></li>
          </ul>
        </div>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    </script>
  </body>
</html>
