---
import Base from './Base.astro';

interface Props {
  title: string;
  updated: string;
}
const { title, updated } = Astro.props;
---

<Base title={title}>
  <article class="wrap max-w-3xl pt-10">
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">{title}</h1>
    <p class="mt-2 text-sm text-faint">{updated}</p>
    <div class="prose-legal card mt-8 p-6 sm:p-8 [&>h2:first-child]:mt-0">
      <slot />
    </div>
  </article>
</Base>
