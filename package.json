{
  "name": "cuet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && astro preview",
    "check": "wrangler types && astro check",
    "deploy": "astro build && wrangler deploy",
    "types": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply CUET_students --remote",
    "db:refresh": "wrangler d1 execute CUET_students --remote --file scripts/refresh-derived.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.156.0"
  }
}
