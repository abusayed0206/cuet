# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage


# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local


# wrangler local state
.wrangler/

# typescript
*.tsbuildinfo

# lock files - use npm
bun.lock
yarn.lock
pnpm-lock.yaml

# migrations with sensitive data
/migrations/0002_*.sql
/migrations/0003_*.sql
/migrations/*_import_*.sql


# CSV data files
/public/*.csv

# astro
dist/
.astro/
.dev.vars*
worker-configuration.d.ts
